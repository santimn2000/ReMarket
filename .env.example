# Copia este fichero a .env (ignorado por git) y cambia los valores.
# Solo valores de ejemplo para desarrollo local: nunca pongas aquí credenciales reales.

# PostgreSQL + PostGIS
POSTGRES_DB=remarket
POSTGRES_USER=remarket
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_PORT=5432

# Redis
REDIS_PASSWORD=change-me-redis
REDIS_PORT=6379

# Silo (fork de MinIO, compatible S3). La contraseña necesita al menos 8 caracteres.
MINIO_ROOT_USER=remarket
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
